          "in": "query",
          "schema": {
            "minimum": 1,
            "default": 1,
            "allOf": [
              {
                "$ref": "#/components/schemas/Object"
              }
            ]
          }
        },
        {
          "name": "limit",
          "required": false,
          "in": "query",
          "schema": {
            "minimum": 1,
            "maximum": 100,
            "default": 20,
            "allOf": [
              {
                "$ref": "#/components/schemas/Object"
              }
            ]

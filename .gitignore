# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/public/references
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results
/.playwright-cli
/output

# local caches
/.cache
/.codex
/.turbo
/.vite

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo

# others
.qodo
.history
.idea

# local agent/tooling state, per-developer and not shareable
.claude/*
# ...except the shared project config: which agent plugins this repo expects.
# `settings.local.json` and `launch.json` stay per-developer via the rule above.
!.claude/settings.json

# raw assets & 3d models
/public/models/
/public/mouth_patch.png
/public/upnext_avatar*.png
/public/upnext_character.*
/public/upnext_mascot_*.png


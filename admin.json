  "/api/v1/admin/auth/login": {
    "post": {
      "description": "Tài khoản test mặc định:\n- Email: `admin.super@upnext.dev` (hoặc `admin.moderator@upnext.dev`, `admin.compliance@upnext.dev`, `admin.finance@upnext.dev`, `admin.support@upnext.dev`)\n- Mật khẩu: `Password123!`",
      "operationId": "AdminAuthController_login_v1",
      "parameters": [],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/LoginDto"
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Đăng nhập thành công",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminLoginResponse"
              }
            }
          }
        },
        "400": {
          "description": "Email hoặc mật khẩu không hợp lệ"
        },
        "401": {
          "description": "Email hoặc mật khẩu không hợp lệ"
        }
      },
      "summary": "Đăng nhập tài khoản Admin",
      "tags": ["Admin - Auth"]
    }
  },
  "/api/v1/admin/dashboard": {
    "get": {
      "operationId": "AdminDashboardController_getDashboard_v1",
      "parameters": [
        {
          "name": "chartPeriod",
          "required": false,
          "in": "query",
          "description": "Khoảng thời gian gom nhóm doanh thu cho biểu đồ.",
          "schema": {
            "default": "year",
            "type": "string",
            "enum": ["week", "month", "year"]
          }
        },
        {
          "name": "year",
          "required": false,
          "in": "query",
          "description": "Năm cần xem biểu đồ. Mặc định là năm hiện tại.",
          "schema": {
            "example": 2026,
            "type": "number"
          }
        },
        {
          "name": "month",
          "required": false,
          "in": "query",
          "description": "Tháng cần xem khi chartPeriod=month. Giá trị 1-12.",
          "schema": {
            "example": 6,
            "type": "number"
          }
        },
        {
          "name": "weekStart",
          "required": false,
          "in": "query",
          "description": "Ngày đầu tuần khi chartPeriod=week. Nếu bỏ trống sẽ lấy tuần hiện tại.",
          "schema": {
            "example": "2026-06-22",
            "type": "string"
          }
        },
        {
          "name": "activityLimit",
          "required": false,
          "in": "query",
          "description": "Số activity mới nhất trả về.",
          "schema": {
            "default": 10,
            "example": 10,
            "type": "number"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Lấy dữ liệu dashboard thống kê nền tảng cho admin thành công."
        }
      },
      "security": [
        {
          "bearer": []
        }
      ],
      "summary": "Lấy dữ liệu dashboard thống kê nền tảng cho admin",
      "tags": ["Admin - Dashboard"]
    }
  },
